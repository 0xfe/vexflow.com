{
  "name": "vexflow.com",
  "version": "1.0.0",
  "description": "Vexflow Website",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "build-dev": "node build.mjs --dev",
    "start": "node build.mjs --dev --serve",
    "serve": "node build.mjs --serve",
    "watch": "node build.mjs --dev --watch",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xfe/vexflow.com.git"
  },
  "keywords": [
    "vexflow"
  ],
  "author": "Mohit Cheppudira",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/0xfe/vexflow.com/issues"
  },
  "homepage": "https://github.com/0xfe/vexflow.com#readme",
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "codejar": "5.0.0",
    "prismjs": "1.30.0",
    "vexflow": "https://codeload.github.com/vexflow/vexflow/tar.gz/105ecaf2e96ff417eb17658073fab4afd2282a2d",
    "vextab": "6.0.0"
  }
}
