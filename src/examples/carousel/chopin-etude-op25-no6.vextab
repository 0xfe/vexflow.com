// Frédéric Chopin, Étude in G-sharp minor, Op. 25 No. 6. Bars 1–8.
// Source edition: https://cantorion.org/music/621/Etude-No.-6-Original-version
// Pitches cross-checked against the CC0 transcription distributed by Noctave.
// https://noctavepiano.com/en/free-library/chopin-etude-in-g-sharp-minor-thirds-op-25/
layout { width 1680 scale 0.525 spacing optical top 8 firstSystemIndent 60 rowGap 12
  heading { tempo "Allegro. 𝅗𝅥 = 69." }
}
meter cut
play { performer chopin tempo 138 instrument 0 }
edition { paper A4 margins 9 8 9 8 staffSize 4.45 }

pattern ascent {
  :16 (B4[finger 1 above] D#5[finger 3 above])[dynamic p] (C#5[finger 2 above] E5[finger 4 above]) crescendo { :16 (C##5[finger 1 above] E#5[finger 5 above]) (D#5[finger 2 above] F#5[finger 3 above])
  (D##5[finger 1 above] F##5[finger 4 above]) (E#5[finger 1 above] G#5[finger 3 above]) (F#5[finger 2 above] An5[finger 4 above]) (F##5[finger 1 above] A#5[finger 3 above])
  (G#5[finger 2 above] B5[finger 4 above]) (G##5[finger 1 above] B#5[finger 5 above]) (A#5[finger 2 above] C#6[finger 3 above]) (A##5[finger 1 above] C##6[finger 4 above])
  (B#5[finger 1 above] D#6[finger 3 above]) (C#6 E6) (C##6 E#6) (D#6 F#6) }
}

piano keys { key G#m beamRests off
  upper { name ""
    voice thirds stem down {
      slur above { :16 (B4[finger 1 above] D#5[finger 4 above])[label "sotto voce" below] (C#5[finger 2 above] E5[finger 5 above]) times 7 { :16 (B4 D#5) (C#5 E5) } |
      times 8 { :16 (B4 D#5) (C#5 E5) } } |
      break system
      slur above { :16 (B4 D#5)[dynamic p] (C#5 E5) (B4 D#5) (C#5 E5)
        (B4 D#5) (C#5 E5) (B4 D#5) (C#5 E5)
        crescendo { :16 (B4 D#5) (C#5 E5) (B4 D#5) (C#5 E5)
        (B4 D#5) (C#5 E5) (B4 D#5) (C#5 E5) |
      :16 (B4[finger 1 above] D#5[finger 4 above]) (C#5[finger 2 above] E5[finger 5 above]) (B4 D#5) (A#4[finger 2 above] C##5[finger 3 above])
        (B4 D#5) (C#5 E5) (B4 D#5) (A#4 C##5)
        (B4 D#5) (C#5 E5) (B4 D#5) (A#4 C##5)
        } diminuendo { :16 (B4 D#5) (C#5 E5) (B4 D#5) (A#4 C##5) } } |
      slur above { use ascent |
      break system
      :16 (D##6 F##6) (E#6 G#6) (F#6[finger 2 above] An6[finger 4 above]) (F##6 A#6) :8 (G#6[finger 2 above] B6[finger 5 above]) } :8 rest :h rest |
      slur above { :16 (E5[finger 1 above] G#5[finger 4 above]) (F#5[finger 2 above] An5[finger 5 above]) (E5 G#5) (F#5 An5)
        (E5 G#5) (F#5 An5) (E5 G#5) (F#5 An5)
        crescendo { :16 (E5 G#5) (F#5 An5) (E5 G#5) (F#5 An5)
        (E5 G#5) (F#5 An5) (E5 G#5) (F#5 An5) |
      :16 (E5[finger 1 above] G#5[finger 4 above]) (F#5[finger 2 above] An5[finger 5 above]) (E5 G#5) (D#5[finger 2 above] F##5[finger 3 above])
        (E5 G#5) (F#5 An5) (E5 G#5) (D#5 F##5)
        (E5 G#5) (F#5 An5) (E5 G#5) (D#5 F##5)
        } diminuendo { :16 (E5 G#5) (F#5 An5) (E5 G#5) (D#5 F##5) } } |
    }
  }
  lower { name ""
    voice accompaniment {
      :w rest |
      :w rest |
      :8 skip D#3 skip F##2 skip D#3 skip D#2 |
      :8 skip D#3 B3 C#3 skip D#3 skip D#2 |
      :8 G#2[staccato below, pedal down] slur above { :8 (B3 D#4 G#4) (B3 D#4 G#4)[pedal up] (B3 D#4 F#4) (B3 D#4 F#4) (G#3 B3 E4) (G#3 B3 E4) (G#3 B3 D#4) |
      :8 (G#3 B3 D#4)[accent above] (D#3 G#3 C#4) (D#3 G#3 C#4) (D#3 G#3 B3) (D#3 G#3 B3) (C#3 D#3 A#3) (C#3 D#3 A#3) (B2 D#3 G#3) } |
      :8 skip E3 skip F##2 skip E3 skip G#1 |
      :8 skip E3 skip D#3 skip E3 skip G#1 |
    }
    voice held stem down {
      :w skip |
      :w skip |
      :q G#2[pedal down] :8 B3[pedal up] skip :q G#2[pedal down] :8 B3[pedal up] skip |
      :q G#2[pedal down] :q skip B2 :8 B3[pedal up] skip |
      :w skip |
      :w skip |
      :q G#2[pedal down] :8 C#4[pedal up] skip :q G#2[pedal down] :8 C#4[pedal up] skip |
      :q G#2[pedal down] :8 C#4[pedal up] skip :q C#3[pedal down] :8 C#4[pedal up] skip |
    }
    voice cantabile stem up {
      times 8 { :w skip | }
    }
  }
}
